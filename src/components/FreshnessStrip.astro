---
/** Explains *why* a subscription — the freshness window, fresh roast vs shelf beans. */
const uid = Math.random().toString(36).slice(2, 8);
---

<section class="border-line bg-panel/40 border-b py-14">
  <div class="mx-auto grid max-w-5xl items-center gap-8 px-5 md:grid-cols-[0.85fr_1.15fr]">
    <div data-reveal>
      <p class="eyebrow mb-4">свежесть</p>
      <p class="text-hi max-w-[42ch] text-[1.02rem]">
        Кофе раскрывается за 3–4 недели после обжарки, а потом вкус угасает. В магазине зерно
        нередко месяцами лежит на полке. Мы обжариваем в день отгрузки и отправляем в первые сутки —
        вы получаете его на подъёме.
      </p>
    </div>

    <div class="panel-scan border-vfd-dim rounded-md border bg-[#05100e] p-4" data-reveal>
      <svg
        viewBox="0 0 460 252"
        class="block h-auto w-full"
        role="img"
        aria-label="График: как меняется вкус кофе по неделям после обжарки. Свежая обжарка выходит на пик к 1–4 неделе и затем угасает; зерно из магазина уже прошло пик."
      >
        <defs>
          <linearGradient id={`fresh-${uid}`} x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="#5ff0d8"></stop>
            <stop offset="60%" stop-color="#5ff0d8"></stop>
            <stop offset="100%" stop-color="#2f7d70"></stop>
          </linearGradient>
        </defs>

        {/* peak window band */}
        <rect x="101" y="28" width="137" height="162" fill="#5ff0d8" opacity="0.06"></rect>
        <line
          x1="101"
          y1="28"
          x2="101"
          y2="190"
          stroke="#1c4d46"
          stroke-width="1"
          stroke-dasharray="3 3"></line>
        <line
          x1="238"
          y1="28"
          x2="238"
          y2="190"
          stroke="#1c4d46"
          stroke-width="1"
          stroke-dasharray="3 3"></line>

        {/* grid */}
        <g stroke="#12362f" stroke-width="1">
          <line x1="56" y1="68" x2="420" y2="68"></line>
          <line x1="56" y1="108" x2="420" y2="108"></line>
          <line x1="56" y1="148" x2="420" y2="148"></line>
          <line x1="147" y1="28" x2="147" y2="190"></line>
          <line x1="329" y1="28" x2="329" y2="190"></line>
        </g>

        {/* axes */}
        <g stroke="#3a4550" stroke-width="1.4">
          <line x1="56" y1="28" x2="56" y2="190"></line>
          <line x1="56" y1="190" x2="420" y2="190"></line>
        </g>

        {/* shelf-beans reference curve */}
        <path
          d="M56 120 C 150 134, 270 155, 420 173"
          fill="none"
          stroke="#3c8071"
          stroke-width="2"
          stroke-dasharray="5 4"
          stroke-linecap="round"></path>

        {/* fresh-roast curve */}
        <path
          d="M56 150 C 70 122, 82 92, 101 82 C 124 70, 132 42, 160 41 C 182 40, 202 42, 216 47 C 252 60, 288 94, 329 108 C 365 121, 398 139, 420 150"
          fill="none"
          stroke={`url(#fresh-${uid})`}
          stroke-width="3"
          stroke-linecap="round"></path>

        {/* ship marker */}
        <circle cx="79" cy="120" r="4.5" fill="#ffb85c"></circle>
        <text x="88" y="99" fill="#ffb85c" font-size="10.5" font-family="inherit"
          >мы отправляем</text
        >
        <text x="88" y="112" fill="#ffb85c" font-size="10.5" font-family="inherit"
          >в первые сутки</text
        >

        {/* band label */}
        <text
          x="170"
          y="24"
          fill="#5ff0d8"
          font-size="11"
          text-anchor="middle"
          font-family="inherit"
        >
          пик вкуса · 1–4 недели
        </text>

        {/* top-left origin label */}
        <text
          x="56"
          y="20"
          fill="#5d656d"
          font-size="10"
          text-anchor="middle"
          font-family="inherit"
        >
          обжарка
        </text>

        {/* x ticks + labels */}
        <g fill="#5d656d" font-size="10" font-family="inherit" text-anchor="middle">
          <text x="56" y="206">0</text>
          <text x="147" y="206">2</text>
          <text x="238" y="206">4</text>
          <text x="329" y="206">6</text>
          <text x="420" y="206">8</text>
          <text x="238" y="226">недель после обжарки</text>
        </g>

        {/* y axis label */}
        <text
          x="20"
          y="112"
          fill="#5d656d"
          font-size="10.5"
          text-anchor="middle"
          font-family="inherit"
          transform="rotate(-90 20 112)"
        >
          вкус · аромат · сладость
        </text>

        {/* legend */}
        <g font-family="inherit" font-size="10.5">
          <line
            x1="292"
            y1="40"
            x2="312"
            y2="40"
            stroke="#5ff0d8"
            stroke-width="3"
            stroke-linecap="round"></line>
          <text x="318" y="43.5" fill="#aeb6bd">свежая обжарка</text>
          <line
            x1="292"
            y1="56"
            x2="312"
            y2="56"
            stroke="#3c8071"
            stroke-width="2"
            stroke-dasharray="5 4"></line>
          <text x="318" y="59.5" fill="#8a94a0">зерно с полки магазина</text>
        </g>
      </svg>
    </div>
  </div>
</section>
