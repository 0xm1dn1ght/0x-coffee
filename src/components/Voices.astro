---
import Panel from './Panel.astro';
import { voices } from '../data/roasts';
---

<Panel
  id="voices"
  eyebrow="обратная связь"
  title="Пишут те, кто уже на подписке — от команд до тех, кто просто любит кофе"
>
  <div class="grid gap-4 sm:grid-cols-3">
    {
      voices.map((voice) => (
        <blockquote class="border-vfd bg-panel border-l-2 p-5" data-reveal>
          <p class="mb-3 text-sm">{voice.quote}</p>
          <footer class="text-dim text-xs tracking-[0.08em] uppercase">— {voice.by}</footer>
        </blockquote>
      ))
    }
  </div>
</Panel>
