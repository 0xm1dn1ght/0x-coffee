---
/** Glowing VFD-style numeric readout. */
interface Props {
  value: string;
  unit?: string;
  /** faint unlit leading digit, like a real segmented display */
  ghost?: string;
  size?: 'md' | 'lg';
  class?: string;
  ariaLabel?: string;
}
const { value, unit, ghost, size = 'md', class: klass, ariaLabel } = Astro.props;
const sizeCls = size === 'lg' ? 'text-[clamp(2.6rem,9vw,4rem)]' : 'text-[clamp(1.8rem,6vw,2.6rem)]';
---

<div
  class:list={[
    'panel-scan border-vfd-dim rounded-md border bg-[#05100e] px-5 py-5',
    'shadow-[inset_0_0_40px_rgb(95_240_216/0.08)]',
    klass,
  ]}
>
  <div
    class:list={['readout-digits', sizeCls]}
    role="img"
    aria-label={ariaLabel ?? `${value} ${unit ?? ''}`}
  >
    {ghost && <span class="text-vfd-dim [text-shadow:none]">{ghost}</span>}{value}{
      unit && <span class="ml-1 text-[0.42em] tracking-normal">{unit}</span>
    }
  </div>
  {
    Astro.slots.has('default') && (
      <div class="text-dim mt-3.5 flex flex-wrap justify-between gap-2 text-xs">
        <slot />
      </div>
    )
  }
</div>
