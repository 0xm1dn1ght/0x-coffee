---
import Panel from './Panel.astro';
import { faq } from '../data/roasts';
---

<Panel id="faq" eyebrow="вопросы" title="Коротко о том, как это устроено">
  <div class="border-line divide-line divide-y border-t" data-reveal>
    {
      faq.map((item) => (
        <details class="group">
          <summary class="text-hi flex cursor-pointer list-none items-center justify-between gap-4 py-4 font-medium [&::-webkit-details-marker]:hidden">
            <span>{item.q}</span>
            <span
              class="text-vfd shrink-0 text-lg leading-none transition-transform duration-200 group-open:rotate-45"
              aria-hidden="true"
            >
              +
            </span>
          </summary>
          <p class="text-dim max-w-[62ch] pb-5 text-sm leading-relaxed">{item.a}</p>
        </details>
      ))
    }
  </div>
</Panel>
